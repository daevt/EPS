<mxfile host="app.diagrams.net" version="32.5.5" type="device" compressed="false">
  <diagram id="EPS-PAGE-001-UC_Overview" name="01 UC_Overview - 3.1 - EPS use-case module map">
    <mxGraphModel dx="1100" dy="1300" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1300" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="map-title" value="3.1  EPS MVP - Use-case Module Map" style="fontFamily=Helvetica;fontSize=14;fontColor=#172b4d;text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="20" width="980" height="60" />
        </mxCell>
        <mxCell id="map-intro" value="22 unique use cases | 7 external actor roles | academic simulation" style="fontFamily=Helvetica;fontSize=14;fontColor=#172b4d;text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="90" width="980" height="40" />
        </mxCell>
        <mxCell id="module-0" value="User / shared  [U1-U8]&#10;Account access (3.1a) + shared escrow actions (3.1b)&#10;Actors: Guest, Buyer, Seller, Admin; Merchant for query only" style="fontFamily=Helvetica;fontSize=14;fontColor=#172b4d;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=18;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="170" width="900" height="145" />
        </mxCell>
        <mxCell id="module-1" value="Buyer  [B1-B4]&#10;Create, cancel, fund and confirm acceptance (3.1c)&#10;Actors: Buyer; Merchant create; Bank/Gateway funding" style="fontFamily=Helvetica;fontSize=14;fontColor=#172b4d;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=18;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="360" width="900" height="145" />
        </mxCell>
        <mxCell id="module-2" value="Seller  [S1-S2]&#10;Accept terms and record delivery/service completion (3.1d)&#10;Actors: Seller" style="fontFamily=Helvetica;fontSize=14;fontColor=#172b4d;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=18;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="550" width="900" height="145" />
        </mxCell>
        <mxCell id="module-3" value="Admin  [A1-A5]&#10;Disputes, policy, dashboard, audit and reconciliation (3.1e)&#10;Actors: Admin; Bank/Gateway reconciliation" style="fontFamily=Helvetica;fontSize=14;fontColor=#172b4d;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=18;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="740" width="900" height="145" />
        </mxCell>
        <mxCell id="module-4" value="Payment integration  [P1-P3]&#10;Confirm funding, release and refund (3.1f)&#10;Actors: Bank and Payment Gateway mocks" style="fontFamily=Helvetica;fontSize=14;fontColor=#172b4d;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=18;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="930" width="900" height="145" />
        </mxCell>
        <mxCell id="map-note" value="Navigation map only: the six focused UML views contain the normative use cases and associations.&#10;Same UC code denotes the same goal; referenced payment use cases are not counted twice.&#10;Merchant API variants B1.API / U4.API reuse the human-channel business contracts." style="fontFamily=Helvetica;fontSize=14;fontColor=#172b4d;rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1150" width="900" height="120" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
