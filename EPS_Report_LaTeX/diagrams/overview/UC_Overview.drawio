        </mxCell>
        <mxCell id="module-1" value="Buyer  [B1-B4]&#10;Create, cancel, fund and confirm acceptance (3.1c)&#10;Actors: Buyer; Merchant create; Bank/Gateway funding" style="fontFamily=Helvetica;fontSize=14;fontColor=#172b4d;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=18;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="360" width="900" height="145" />
